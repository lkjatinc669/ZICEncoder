<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:layout_margin="24dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Header Include -->
    <include
        android:id="@+id/zicHeader"
        layout="@layout/layout_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Passcode Section (Title & Indicators) -->
    <LinearLayout
        android:id="@+id/passcodeSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/zicHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_extra_bold"
            android:text="Enter Passcode"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:accessibilityHeading="true" />

        <!-- Eight passcode indicators -->
        <LinearLayout
            android:id="@+id/passcodeIndicators"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <ImageView
                android:id="@+id/pinic1"
                style="@style/PasscodeIndicator"
                android:src="@drawable/ic_passcode_empty" />

            <ImageView
                android:id="@+id/pinic2"
                style="@style/PasscodeIndicator"
                android:src="@drawable/ic_passcode_empty" />

            <ImageView
                android:id="@+id/pinic3"
                style="@style/PasscodeIndicator"
                android:src="@drawable/ic_passcode_empty" />

            <ImageView
                android:id="@+id/pinic4"
                style="@style/PasscodeIndicator"
                android:src="@drawable/ic_passcode_empty" />

            <ImageView
                android:id="@+id/pinic5"
                style="@style/PasscodeIndicator"
                android:src="@drawable/ic_passcode_empty" />

            <ImageView
                android:id="@+id/pinic6"
                style="@style/PasscodeIndicator"
                android:src="@drawable/ic_passcode_empty" />

            <ImageView
                android:id="@+id/pinic7"
                style="@style/PasscodeIndicator"
                android:src="@drawable/ic_passcode_empty" />

            <ImageView
                android:id="@+id/pinic8"
                style="@style/PasscodeIndicator"
                android:src="@drawable/ic_passcode_empty" />

        </LinearLayout>

    </LinearLayout>

    <!-- Numeric Keypad Grid -->
    <GridLayout
        android:id="@+id/keypadGrid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:alignmentMode="alignBounds"
        android:useDefaultMargins="false"
        app:layout_constraintTop_toBottomOf="@id/passcodeSection"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 1 -->
        <TextView
            android:id="@+id/one"
            style="@style/KeypadButton"
            android:text="1" />

        <TextView
            android:id="@+id/two"
            style="@style/KeypadButton"
            android:text="2" />

        <TextView
            android:id="@+id/three"
            style="@style/KeypadButton"
            android:text="3" />

        <!-- Row 2 -->
        <TextView
            android:id="@+id/four"
            style="@style/KeypadButton"
            android:text="4" />

        <TextView
            android:id="@+id/five"
            style="@style/KeypadButton"
            android:text="5" />

        <TextView
            android:id="@+id/six"
            style="@style/KeypadButton"
            android:text="6" />

        <!-- Row 3 -->
        <TextView
            android:id="@+id/seven"
            style="@style/KeypadButton"
            android:text="7" />

        <TextView
            android:id="@+id/eight"
            style="@style/KeypadButton"
            android:text="8" />

        <TextView
            android:id="@+id/nine"
            style="@style/KeypadButton"
            android:text="9" />

        <!-- Row 4 -->
        <View
            android:layout_width="@dimen/keypad_button_size"
            android:layout_height="@dimen/keypad_button_size"
            android:layout_margin="@dimen/keypad_button_margin"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/zero"
            style="@style/KeypadButton"
            android:text="0" />

        <ImageButton
            android:id="@+id/clear_pass"
            style="@style/KeypadButton"
            android:src="@drawable/ic_back_space"
            android:contentDescription="Delete last passcode digit"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:padding="24dp"
            app:tint="#FFFFFF" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>