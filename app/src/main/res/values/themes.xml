<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ZICEncrypter" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->

        <item name="android:windowBackground">@drawable/bg_main_gradient</item>
    </style>




    <style name="PasscodeIndicator">
        <item name="android:layout_width">@dimen/passcode_dot_size</item>
        <item name="android:layout_height">@dimen/passcode_dot_size</item>
        <item name="android:layout_marginStart">@dimen/passcode_dot_margin</item>
        <item name="android:layout_marginEnd">@dimen/passcode_dot_margin</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:contentDescription">Passcode digit indicator</item>
    </style>

    <style name="PinCellSlot">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/bg_pin_cell</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#111111</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="KeypadButton">
        <item name="android:layout_width">@dimen/keypad_button_size</item>
        <item name="android:layout_height">@dimen/keypad_button_size</item>
        <item name="android:layout_margin">@dimen/keypad_button_margin</item>
        <item name="android:background">@drawable/bg_keypad_button</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">@font/montserrat_regular</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>


    <style name="ZICPrimaryButton" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="ZICOutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Theme.ZICEncrypter" parent="Base.Theme.ZICEncrypter" />
</resources>